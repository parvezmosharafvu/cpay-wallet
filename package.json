    "better-auth": "~1.7.7",
    "jose": "6.2.9",
    "jsqr": "^1.4.0",
    "kysely": "^0.28.5",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
