# Public build-time options. Never put wallet recovery phrases in environment variables.
VITE_AUTH_ENABLED=false
# Wallet pages exclude third-party generator scripts by default.
VITE_GROK_EXTENSIONS=0
# Public Breez application key, required for mainnet service access.
VITE_BREEZ_API_KEY=
# Production ads require real native app IDs AND a real banner unit.
VITE_ADMOB_PRODUCTION=false
VITE_ADMOB_BANNER_UNIT_ID=

# Optional server account authentication only; it does not recover a local wallet vault.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
